    "countries": ["Kenya"],
    "category": "Mobile money",
    "color": "#3DB54A",
    "docsUrl": "https://developer.safaricom.co.ke",
    "statusPageUrl": "https://developer.safaricom.co.ke",
    "endpoints": [
      {
        "name": "M-Pesa OAuth access token",
        "description": "Every Daraja call needs this token first. If it fails, STK Push and B2C fail too.",
        "method": "GET",
        "path": "/oauth/v1/generate?grant_type=client_credentials",
        "liveUrl": "https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials",
        "headersHint": "Authorization: Basic <base64(consumer_key:consumer_secret)>",
        "expectedStatus": 200,
        "expectedFields": ["access_token", "expires_in"],
        "sampleResponse": {"access_token": "c9SQxWWhmdVRlyh0zh8gZDTkubVF", "expires_in": "3599"}
      },
      {
        "name": "M-Pesa STK Push (Lipa Na M-Pesa)",
        "description": "Sends the payment prompt to the customer's phone.",
        "method": "POST",
        "path": "/mpesa/stkpush/v1/processrequest",
        "liveUrl": "https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest",
        "headersHint": "Authorization: Bearer <access_token>\nContent-Type: application/json",
        "body": "{\"BusinessShortCode\":\"174379\",\"TransactionType\":\"CustomerPayBillOnline\",\"Amount\":\"1\",\"PartyA\":\"254708374149\",\"PartyB\":\"174379\",\"PhoneNumber\":\"254708374149\",\"CallBackURL\":\"https://example.com/callback\",\"AccountReference\":\"KingaTest\",\"TransactionDesc\":\"Health check\"}",
        "expectedStatus": 200,
        "expectedFields": ["MerchantRequestID", "CheckoutRequestID", "ResponseCode"],
        "sampleResponse": {
          "MerchantRequestID": "29115-34620561-1",
          "CheckoutRequestID": "ws_CO_191220191020363925",
          "ResponseCode": "0",
          "ResponseDescription": "Success. Request accepted for processing",
          "CustomerMessage": "Success. Request accepted for processing"
        }
      }
    ]
  },
